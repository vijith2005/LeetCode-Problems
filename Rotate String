class Solution {
    public boolean rotateString(String s, String goal) {
        String temp = s+s ;
        if (s.length() != goal.length()) return false;
        int n = temp.length() ;
        boolean flg = false ;
        for(int i = 0 ; i < temp.length() - goal.length() ; i++){
            if(temp.charAt(i) == goal.charAt(0)){
                for(int j = 0 ; j < goal.length() ; j++){
                    if(temp.charAt(i+j) == goal.charAt(j)){
                        if(j == goal.length()-1) flg = true;
                    }
                    else break ;
                }
            }
        }
        return flg;
    }
}
